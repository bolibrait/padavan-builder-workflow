

CONFIG_FIRMWARE_INCLUDE_TC=n
========================

CONFIG_VENDOR=ZBT
CONFIG_FIRMWARE_PRODUCT_ID="ZBT-WE826tt"
CONFIG_FIRMWARE_TYPE_ROOTFS_IN_RAM=n
CONFIG_FIRMWARE_ROOTFS_IN_RAM=n

### Target ###
CONFIG_FIRMWARE_CPU_MT7620=y
CONFIG_FIRMWARE_CPU_SLEEP=y
CONFIG_FIRMWARE_WIFI2_DRIVER=2.7
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0

### Flash / RAM ###
CONFIG_FIRMWARE_FLASH_SIZE=8
CONFIG_FIRMWARE_RAM_SIZE=64

### Include compressed memory support
CONFIG_FIRMWARE_INCLUDE_ZRAM=y

### Languages ###
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
CONFIG_FIRMWARE_INCLUDE_LANG_EN=y

### Core & Network ###
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_IPTABLES_EXT=y
CONFIG_FIRMWARE_INCLUDE_TC=y
CONFIG_FIRMWARE_INCLUDE_SSLSUPPORT=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_OPENSSH=n
CONFIG_FIRMWARE_INCLUDE_SFTP=n

### Disable heavy packages to fit 8MB Flash ###
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n
CONFIG_FIRMWARE_INCLUDE_STRONGWAN=n
CONFIG_FIRMWARE_INCLUDE_USB=n
CONFIG_FIRMWARE_INCLUDE_STORAGE=n
CONFIG_FIRMWARE_INCLUDE_SAMBA=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_FIREFLY=n
CONFIG_FIRMWARE_INCLUDE_ARIA=n
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=n
CONFIG_FIRMWARE_INCLUDE_MTR=n
CONFIG_FIRMWARE_INCLUDE_SOCAT=n
